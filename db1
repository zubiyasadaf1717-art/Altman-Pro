# =============================================================================
# 5. SERVER
# =============================================================================

server <- function(input, output, session) {
  
  # ---- Helpers for Tabs 5-6 -----------------------------------------------
  selected_results <- reactive({
    switch(input$selected_model,
           "Logistic Regression" = lr_results,
           "Random Forest"       = rf_results,
           "Neural Network"      = nn_results)
  })
  selected_colour <- reactive({
    switch(input$selected_model,
           "Logistic Regression" = "#2980B9",
           "Random Forest"       = "#27AE60",
           "Neural Network"      = "#8E44AD")
  })
  
  # ---- SMOTE plot ---------------------------------------------------------
  output$smote_plot <- renderPlot({
    before <- table(df_final$Bankrupt)
    after  <- table(train$Bankrupt)
    bd <- data.frame(
      Stage = rep(c("Before SMOTE","After SMOTE"), each=2),
      Class = rep(c("Not Bankrupt","Bankrupt"), 2),
      Count = c(as.numeric(before), as.numeric(after))
    )
    bd$Stage <- factor(bd$Stage, levels=c("Before SMOTE","After SMOTE"))
    ggplot(bd, aes(x=Class, y=Count, fill=Class)) +
      geom_bar(stat="identity", width=0.5) +
      geom_text(aes(label=Count), vjust=-0.4, size=4, fontface="bold", colour="white") +
      facet_wrap(~Stage) +
      scale_fill_manual(values=c("Not Bankrupt"="#2ECC71","Bankrupt"="#E74C3C")) +
      ylim(0, max(bd$Count)*1.15) + labs(x="",y="Count") +
      theme_minimal(base_size=11) +
      theme(legend.position="none",
            plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            panel.grid      =element_line(colour="#2A2A4A"),
            text            =element_text(colour="#E0E0E0"),
            strip.text      =element_text(colour="#F0C040",size=11))
  }, bg="#16213E")
  
  # ---- Feature importance plot --------------------------------------------
  output$importance_plot <- renderPlot({
    top15 <- head(importance_df, 15)
    ggplot(top15, aes(x=reorder(Feature,MeanDecreaseGini), y=MeanDecreaseGini)) +
      geom_bar(stat="identity", fill="#F0C040") + coord_flip() +
      labs(x="",y="Mean Decrease Gini") +
      theme_minimal(base_size=9) +
      theme(plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            panel.grid      =element_line(colour="#2A2A4A"),
            text            =element_text(colour="#E0E0E0"))
  }, bg="#16213E")
  
  # ---- Confusion matrix plot ----------------------------------------------
  output$cm_plot <- renderPlot({
    cm_df <- as.data.frame(selected_results()$cm$table)
    colnames(cm_df) <- c("Predicted","Actual","Count")
    col <- selected_colour()
    ggplot(cm_df, aes(x=Predicted, y=Actual, fill=Count)) +
      geom_tile(colour="white") +
      geom_text(aes(label=Count), size=10, fontface="bold", colour="white") +
      scale_fill_gradient(low=col, high="#0D0D1A") +
      labs(x="Predicted Class",y="Actual Class") +
      theme_minimal(base_size=13) +
      theme(legend.position="none",
            plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            text            =element_text(colour="#E0E0E0"),
            axis.text       =element_text(colour="#E0E0E0",size=12))
  }, bg="#16213E")
  
  # ---- ROC curve plot -----------------------------------------------------
  output$roc_plot <- renderPlot({
    roc_obj <- selected_results()$roc
    auc_val <- selected_results()$auc
    col     <- selected_colour()
    roc_df  <- data.frame(FPR=1-roc_obj$specificities, TPR=roc_obj$sensitivities)
    ggplot(roc_df, aes(x=FPR,y=TPR)) +
      geom_line(colour=col, linewidth=1.5) +
      geom_abline(linetype="dashed", colour="grey50") +
      annotate("text", x=0.6, y=0.15,
               label=paste0("AUC = ",auc_val), size=5, colour=col, fontface="bold") +
      labs(x="False Positive Rate",y="True Positive Rate") +
      theme_minimal(base_size=12) +
      theme(plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            panel.grid      =element_line(colour="#2A2A4A"),
            text            =element_text(colour="#E0E0E0"))
  }, bg="#16213E")
  
  # ---- Metric boxes -------------------------------------------------------
  mb <- function(v,l) renderUI(tags$div(class="metric-box",
                                        tags$div(class="metric-value",v), tags$div(class="metric-label",l)))
  
  observeEvent(input$selected_model, {
    res <- selected_results()
    output$metric_accuracy    <- mb(paste0(res$metrics$Accuracy,    "%"),"Accuracy")
    output$metric_precision   <- mb(paste0(res$metrics$Precision,   "%"),"Precision")
    output$metric_recall      <- mb(paste0(res$metrics$Recall,      "%"),"Recall")
    output$metric_f1          <- mb(paste0(res$metrics$F1_Score,    "%"),"F1 Score")
    output$metric_specificity <- mb(paste0(res$metrics$Specificity, "%"),"Specificity")
    output$metric_auc         <- mb(res$metrics$AUC_ROC,             "AUC-ROC")
  })
  
  # ---- Combined ROC -------------------------------------------------------
  output$combined_roc <- renderPlot({
    mk <- function(r,lbl) data.frame(
      FPR=1-r$roc$specificities, TPR=r$roc$sensitivities, Model=lbl)
    roc_all <- bind_rows(
      mk(lr_results, paste0("LR (AUC=",lr_results$auc,")")),
      mk(rf_results, paste0("RF (AUC=",rf_results$auc,")")),
      mk(nn_results, paste0("NN (AUC=",nn_results$auc,")"))
    )
    cols <- setNames(c("#2980B9","#27AE60","#8E44AD"), unique(roc_all$Model))
    ggplot(roc_all, aes(x=FPR,y=TPR,colour=Model)) +
      geom_line(linewidth=1.4) +
      geom_abline(linetype="dashed",colour="grey50") +
      scale_colour_manual(values=cols) +
      labs(x="False Positive Rate",y="True Positive Rate",colour="") +
      theme_minimal(base_size=11) +
      theme(legend.position="bottom",
            legend.text     =element_text(size=9,colour="#E0E0E0"),
            plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            panel.grid      =element_line(colour="#2A2A4A"),
            text            =element_text(colour="#E0E0E0"))
  }, bg="#16213E")
  
  # ---- Metrics table ------------------------------------------------------
  output$metrics_table <- renderDT({
    datatable(comparison_df,
              options=list(dom="t", pageLength=3,
                           initComplete=JS("function(s,j){",
                                           "$(this.api().table().header()).css({'background-color':'#0F3460','color':'#F0C040'});","}")),
              rownames=FALSE, class="compact") %>%
      formatStyle(1:7, backgroundColor="#16213E", color="#E0E0E0")
  })
  
  # ---- CM summary bar -----------------------------------------------------
  output$cm_summary_plot <- renderPlot({
    pd <- data.frame(
      Model = rep(cm_summary$Model,2),
      Type  = c(rep("Bankruptcies Caught (TP)",3),rep("False Alarms (FP)",3)),
      Count = c(cm_summary$True_Positive, cm_summary$False_Positive)
    )
    ggplot(pd, aes(x=Model,y=Count,fill=Type)) +
      geom_bar(stat="identity",position="dodge",width=0.6) +
      geom_text(aes(label=Count), position=position_dodge(width=0.6),
                vjust=-0.4, size=4.5, fontface="bold", colour="white") +
      scale_fill_manual(values=c("Bankruptcies Caught (TP)"="#2ECC71",
                                 "False Alarms (FP)"="#E74C3C")) +
      ylim(0,max(pd$Count)*1.15) + labs(x="",y="Count",fill="") +
      theme_minimal(base_size=12) +
      theme(legend.position="bottom",
            legend.text     =element_text(colour="#E0E0E0"),
            plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            panel.grid      =element_line(colour="#2A2A4A"),
            text            =element_text(colour="#E0E0E0"),
            axis.text.x     =element_text(colour="#F0C040",size=11,face="bold"))
  }, bg="#16213E")
  
  
  # =========================================================================
  # TAB 7 - LIVE PREDICTION
  # =========================================================================
  
  # ---- Preset loaders -----------------------------------------------------
  observeEvent(input$preset_safe,  {
    for (i in seq_along(SELECTED_FEATURES))
      updateNumericInput(session, paste0("feat_",i), value=PRESET_SAFE[i])
  })
  observeEvent(input$preset_risk, {
    for (i in seq_along(SELECTED_FEATURES))
      updateNumericInput(session, paste0("feat_",i), value=PRESET_RISK[i])
  })
  observeEvent(input$preset_clear, {
    for (i in seq_along(SELECTED_FEATURES))
      updateNumericInput(session, paste0("feat_",i), value=FEATURE_MEDIANS[i])
  })
  
  # ---- Core prediction (button-triggered) ---------------------------------
  pred_results <- eventReactive(input$run_prediction, {
    
    req(length(input$pred_models) > 0)
    
    # 1. Read all 22 input values
    raw_vals <- setNames(
      sapply(seq_along(SELECTED_FEATURES), function(i) {
        v <- input[[paste0("feat_",i)]]
        if (is.null(v) || is.na(v)) FEATURE_MEDIANS[i] else as.numeric(v)
      }),
      SELECTED_FEATURES
    )
    
    # 2. Build separate data frames for numeric and binary features.
    # Use the scaler's own column names (ground truth) to avoid encoding mismatches
    # between the hardcoded NUMERIC_FEATURES strings and the actual .rds column names.
    scaler_cols  <- if (!is.null(scaler)) names(scaler$mean) else NUMERIC_FEATURES
    numeric_vals <- setNames(as.numeric(raw_vals[seq_along(NUMERIC_FEATURES)]), scaler_cols)
    numeric_df   <- as.data.frame(as.list(numeric_vals), stringsAsFactors = FALSE)
    binary_df    <- as.data.frame(as.list(raw_vals[BINARY_FEATURES]), stringsAsFactors = FALSE)
    
    # 3. Scale ONLY the 20 numeric features using the saved scaler
    if (!is.null(scaler)) {
      numeric_scaled <- predict(scaler, numeric_df)
    } else {
      # Fallback: manual standardisation from training column statistics
      numeric_scaled <- numeric_df
      train_cols <- colnames(train)[colnames(train) %in% scaler_cols]
      for (f in train_cols) {
        mn <- mean(train[[f]], na.rm = TRUE)
        s  <- sd(train[[f]],   na.rm = TRUE)
        if (is.na(s) || s == 0) s <- 1
        numeric_scaled[[f]] <- (numeric_df[[f]] - mn) / s
      }
    }
    
    # 4. Reassemble full 22-column row in the EXACT column order the models expect
    input_scaled <- cbind(numeric_scaled, binary_df)
    
    # Order by the canonical feature list derived from the training data
    model_cols   <- c(scaler_cols, BINARY_FEATURES)
    input_scaled <- input_scaled[, model_cols, drop = FALSE]
    
    # 5. Add Bankrupt factor column (required by caret predict)
    input_scaled$Bankrupt <- factor("No", levels = c("No", "Yes"))
    
    # 6. Run each selected model
    probs <- list()
    
    if ("Logistic Regression" %in% input$pred_models) {
      probs[["Logistic Regression"]] <- tryCatch(
        as.numeric(predict(lr_results$model, newdata=input_scaled, type="prob")[,"Yes"]),
        error = function(e) { message("LR error: ", e$message); NA_real_ }
      )
    }
    if ("Random Forest" %in% input$pred_models) {
      probs[["Random Forest"]] <- tryCatch(
        as.numeric(predict(rf_results$model, newdata=input_scaled, type="prob")[,"Yes"]),
        error = function(e) { message("RF error: ", e$message); NA_real_ }
      )
    }
    if ("Neural Network" %in% input$pred_models) {
      probs[["Neural Network"]] <- tryCatch(
        as.numeric(predict(nn_results$model, newdata=input_scaled, type="prob")[,"Yes"]),
        error = function(e) { message("NN error: ", e$message); NA_real_ }
      )
    }
    
    valid_p  <- unlist(probs[!is.na(unlist(probs))])
    avg_prob <- if (length(valid_p) > 0) mean(valid_p) else 0
    
    # 7. Risk driver scores (LR coefficient x deviation from training median)
    contributions <- setNames(
      LR_COEFS * (raw_vals - FEATURE_MEDIANS),
      FEATURE_LABELS
    )
    
    list(probs=probs, avg_prob=avg_prob, contributions=contributions)
  })
  
  # ---- Flag for conditionalPanel ------------------------------------------
  output$pred_done <- reactive({
    !is.null(pred_results()) && input$run_prediction > 0
  })
  outputOptions(output, "pred_done", suspendWhenHidden = FALSE)
  
  # ---- Gauge UI -----------------------------------------------------------
  output$pred_gauge <- renderUI({
    
    if (is.null(input$run_prediction) || input$run_prediction == 0) {
      return(tags$div(
        style="text-align:center;padding:40px;color:#555;",
        tags$div(style="font-size:44px;margin-bottom:10px;", "o"),
        tags$p("Enter financial ratios and click Run Prediction")
      ))
    }
    
    res  <- pred_results()
    pct  <- round(res$avg_prob * 100, 1)
    col  <- if (pct < 25) "#2ECC71" else if (pct < 50) "#F0C040" else "#E74C3C"
    vt   <- if (pct < 25) "LOW RISK" else if (pct < 50) "MODERATE RISK" else if (pct < 75) "HIGH RISK" else "CRITICAL RISK"
    vcls <- if (pct < 25) "verdict-safe" else if (pct < 50) "verdict-warn" else if (pct < 75) "verdict-risk" else "verdict-critical"
    note <- if (pct < 25) "Company appears financially stable." else
      if (pct < 50) "Some financial stress indicators present." else
        if (pct < 75) "Significant distress signals detected." else
          "Severe financial distress — high bankruptcy risk."
    
    tags$div(class="result-panel",
             tags$div(class="result-prob-big", style=paste0("color:",col), paste0(pct,"%")),
             tags$div(class="result-label", "Average Bankruptcy Probability"),
             tags$div(class=paste0("result-verdict ",vcls), vt),
             tags$p(style=paste0("color:",col,";font-size:12px;margin-top:8px;"), note)
    )
  })
  
  # ---- Per-model probabilities --------------------------------------------
  output$pred_model_breakdown <- renderUI({
    res  <- pred_results()
    cols <- c("Logistic Regression"="#2980B9",
              "Random Forest"      ="#27AE60",
              "Neural Network"     ="#8E44AD")
    rows <- lapply(names(res$probs), function(m) {
      p <- res$probs[[m]]
      tags$div(class="model-prob-row",
               tags$span(class="model-prob-name", style=paste0("color:",cols[m]), m),
               tags$span(class="model-prob-val",  style=paste0("color:",cols[m]),
                         if (!is.na(p)) paste0(round(p*100,1),"%") else "Error")
      )
    })
    tags$div(rows)
  })
  
  # ---- Risk drivers -------------------------------------------------------
  output$pred_risk_drivers <- renderUI({
    res    <- pred_results()
    ctribs <- res$contributions
    top5   <- names(sort(abs(ctribs), decreasing=TRUE))[1:min(5,length(ctribs))]
    rows   <- lapply(top5, function(feat) {
      val  <- ctribs[feat]
      cls  <- if (val > 0) "driver-up" else "driver-down"
      sign <- if (val > 0) "Up Risk" else "Down Risk"
      tags$div(class="risk-driver-row",
               tags$span(class="driver-name", substr(feat,1,32)),
               tags$span(class=cls, paste0(sign,"  (",round(abs(val),3),")"))
      )
    })
    tags$div(rows)
  })
  
  # ---- Comparison bar plot ------------------------------------------------
  output$pred_bar_plot <- renderPlot({
    res     <- pred_results()
    plot_df <- data.frame(
      Model = names(res$probs),
      Prob  = sapply(res$probs, function(p) if(!is.na(p)) round(p*100,1) else 0),
      stringsAsFactors = FALSE
    )
    col_map <- c("Logistic Regression"="#2980B9",
                 "Random Forest"      ="#27AE60",
                 "Neural Network"     ="#8E44AD")
    plot_df$Model <- factor(plot_df$Model, levels=names(col_map))
    
    ggplot(plot_df, aes(x=Model, y=Prob, fill=Model)) +
      geom_bar(stat="identity", width=0.5) +
      geom_text(aes(label=paste0(Prob,"%")),
                vjust=-0.4, size=5, fontface="bold", colour="white") +
      geom_hline(yintercept=50, linetype="dashed", colour="#F0C040", linewidth=0.8) +
      annotate("text", x=0.55, y=54, label="50% threshold",
               size=3.5, colour="#F0C040") +
      scale_fill_manual(values=col_map) +
      scale_y_continuous(limits=c(0,115), labels=function(x) paste0(x,"%")) +
      labs(x="",y="Bankruptcy Probability") +
      theme_minimal(base_size=12) +
      theme(legend.position="none",
            plot.background =element_rect(fill="#16213E",colour=NA),
            panel.background=element_rect(fill="#16213E",colour=NA),
            panel.grid      =element_line(colour="#2A2A4A"),
            text            =element_text(colour="#E0E0E0"),
            axis.text.x     =element_text(colour="#F0C040",size=12,face="bold"))
  }, bg="#16213E")
  
} # end server


# =============================================================================
# 6. RUN APP
# =============================================================================

shinyApp(ui = ui, server = server)
