              fluidRow(
                box(width=12, title="Final Recommendation",
                    fluidRow(
                      column(6, tags$div(class="model-card card-rf",
                                         tags$h4(tags$span(class="badge-green","BEST OVERALL")," Random Forest"),
                                         tags$p("Highest accuracy (93.7%), F1 (41.9%), specificity (94.5%).
                        Fewest false alarms (73). Best for general screening.")
                      )),
                      column(6, tags$div(class="model-card card-lr",
                                         tags$h4(tags$span(class="badge-blue","BEST FOR RISK")," Logistic Regression"),
                                         tags$p("Highest recall (90.9%) and AUC-ROC (0.941). Catches 40 of 44 real
                        bankruptcies. Best when missing a case is more costly than a false alarm.")
                      ))
                    )
                )
              )
      ),
      
      # =======================================================================
      # TAB 7: LIVE PREDICTION
      # =======================================================================
      tabItem(tabName = "prediction",
              
              fluidRow(column(12,
                              tags$h2("7. Live Bankruptcy Prediction"),
                              tags$p("Enter a company's financial ratios and click ",
                                     tags$strong("Run Prediction"), " to get real-time probabilities from
                 all three trained models. The 20 continuous features are scaled with
                 the original ", tags$code("scaler.rds"), "; the 2 binary flags are
                 passed unscaled — exactly replicating the training pipeline.")
              )),
              
              fluidRow(
                
                # ---- LEFT: inputs ------------------------------------------------
                column(8,
                       
                       box(width=12, title="Options",
                           fluidRow(
                             column(6,
                                    tags$label(class="predict-input-label", "Select Model(s)"),
                                    checkboxGroupInput("pred_models", label=NULL,
                                                       choices  = c("Logistic Regression","Random Forest","Neural Network"),
                                                       selected = c("Logistic Regression","Random Forest","Neural Network"),
                                                       inline   = TRUE)
                             ),
                             column(6,
                                    tags$label(class="predict-input-label","Load Preset"),
                                    tags$br(),
                                    tags$div(class="preset-btn-row",
                                             actionButton("preset_safe", "Safe Company",
                                                          style="background:#27AE60;color:#fff;border:none;border-radius:4px;padding:6px 14px;"),
                                             actionButton("preset_risk", "At-Risk Company",
                                                          style="background:#E74C3C;color:#fff;border:none;border-radius:4px;padding:6px 14px;"),
                                             actionButton("preset_clear","Clear",
                                                          style="background:#555;color:#fff;border:none;border-radius:4px;padding:6px 14px;")
                                    )
                             )
                           )
                       ),
                       
                       box(width=12, title="Financial Ratios (22 Features)",
                           tags$p(style="color:#AAA;font-size:11px;margin-bottom:14px;",
                                  "Features 1-20: continuous (will be standardised automatically).
                 Features 21-22: binary flags, enter 0 or 1 only."),
                           fluidRow(
                             column(6,
                                    lapply(1:11, function(i) {
                                      tags$div(class="predict-input-card",
                                               tags$label(class="predict-input-label",
                                                          paste0(i, ". ", FEATURE_LABELS[i])),
                                               numericInput(paste0("feat_", i), label=NULL,
                                                            value = FEATURE_MEDIANS[i],
                                                            step  = if (i > 20) 1 else 0.001,
                                                            min   = 0,
                                                            max   = if (i > 20) 1 else NA),
                                               tags$div(class="predict-input-hint", FEATURE_HINTS[i])
