const MODEL_STATS = {
  lr: { name: "Logistic Regression", acc: 88.11, prec: 20.2, recall: 90.91, f1: 33.06, auc: 0.9414, color: "#00e5ff" },
  rf: { name: "Random Forest",       acc: 93.69, prec: 29.81, recall: 70.45, f1: 41.89, auc: 0.9235, color: "#7c3aed" },
