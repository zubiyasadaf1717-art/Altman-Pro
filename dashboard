];

// Safe company preset (healthy financials — low bankruptcy risk)
const PRESET_SAFE = {
  net_income_ta:0.62, cont_int_rate:0.85, persist_eps:0.35, pretax_int_rate:0.88,
  tot_inc_exp:0.99, ret_earn_ta:0.68, tot_debt_nw:0.25, borrow_dep:0.20,
  nprofit_cap:0.28, eps_per_share:0.30, nw_assets:0.72, debt_ratio:0.28,
  int_debt_rate:0.12, roa_c:0.60, quick_ratio:1.80, cash_turnover:0.75,
  eq_liab:2.50, roa_a:0.58, int_exp_ratio:0.02, roa_b:0.62,
  liab_assets_flag:0, net_income_flag:1
};

// At-risk company preset (poor financials — high bankruptcy risk)
const PRESET_RISK = {
  net_income_ta:0.10, cont_int_rate:0.40, persist_eps:0.05, pretax_int_rate:0.35,
  tot_inc_exp:0.60, ret_earn_ta:0.08, tot_debt_nw:3.50, borrow_dep:0.85,
  nprofit_cap:0.02, eps_per_share:0.03, nw_assets:0.12, debt_ratio:0.88,
  int_debt_rate:0.75, roa_c:0.25, quick_ratio:0.35, cash_turnover:0.18,
  eq_liab:0.15, roa_a:0.12, int_exp_ratio:0.45, roa_b:0.20,
  liab_assets_flag:1, net_income_flag:0
};

// =============================================================================
// LR Model — coefficients from model1_logistic_regression.R
// Intercept estimated from class distribution + feature means
// =============================================================================
const LR_INTERCEPT = 1.85;
const LR_COEF = {
  net_income_ta:-2.606, cont_int_rate:-1.736, persist_eps:-2.203,
  pretax_int_rate:1.809, tot_inc_exp:-7.540, ret_earn_ta:0.254,
  tot_debt_nw:0.095, borrow_dep:0.581, nprofit_cap:-0.594,
  eps_per_share:0.547, nw_assets:0, debt_ratio:1.692,
  int_debt_rate:-0.086, roa_c:-0.381, quick_ratio:0.015,
  cash_turnover:-0.437, eq_liab:0.150, roa_a:2.341,
  int_exp_ratio:0.033, roa_b:-0.307,
  liab_assets_flag:-2.266, net_income_flag:0
};

// =============================================================================
// RF Model — approximation using feature weights (Gini-normalised)
// =============================================================================
function sigmoid(x) { return 1 / (1 + Math.exp(-x)); }

function predictLR(vals) {
  let logit = LR_INTERCEPT;
  for (const [k, coef] of Object.entries(LR_COEF)) {
    if (vals[k] !== undefined) logit += coef * (vals[k] - 0.5);
  }
  return sigmoid(logit);
}

function predictRF(vals) {
  // RF approximation: weighted risk score using Gini importance and directionality
  // Higher ROA/earnings = lower risk; higher debt/borrowing = higher risk
  const riskFactors = {
    net_income_ta: -0.22,   cont_int_rate: -0.19,  persist_eps: -0.15,
    pretax_int_rate: -0.13, tot_inc_exp: -0.13,    ret_earn_ta: -0.12,
    tot_debt_nw: 0.11,      borrow_dep: 0.10,      nprofit_cap: -0.09,
    eps_per_share: -0.07,   nw_assets: -0.07,      debt_ratio: 0.07,
    int_debt_rate: 0.06,    roa_c: -0.06,          quick_ratio: -0.06,
    cash_turnover: -0.06,   eq_liab: -0.05,        roa_a: -0.05,
    int_exp_ratio: 0.05,    roa_b: -0.05,
    liab_assets_flag: 0.09, net_income_flag: -0.04
  };
  let score = 0;
  for (const [k, w] of Object.entries(riskFactors)) {
    if (vals[k] !== undefined) score += w * (vals[k] - 0.5);
  }
  return sigmoid(score * 3.2 + 0.3);
}

function predictNN(vals) {
  // NN approximation: MLP with a single hidden representation
  // Uses tanh activation on a linear combination, then sigmoid output
  const w1 = {
    net_income_ta:-1.8, cont_int_rate:-1.4, persist_eps:-1.6, pretax_int_rate:1.2,
    tot_inc_exp:-2.4, ret_earn_ta:0.4, tot_debt_nw:0.6, borrow_dep:0.7,
    nprofit_cap:-0.8, eps_per_share:0.5, nw_assets:-0.5, debt_ratio:1.1,
    int_debt_rate:0.3, roa_c:-0.6, quick_ratio:0.1, cash_turnover:-0.5,
    eq_liab:0.3, roa_a:1.5, int_exp_ratio:0.2, roa_b:-0.4,
    liab_assets_flag:-1.8, net_income_flag:-0.3
  };
  let h = 0;
  for (const [k, w] of Object.entries(w1)) {
    if (vals[k] !== undefined) h += w * (vals[k] - 0.5);
  }
  const hidden = Math.tanh(h * 0.8);
  return sigmoid(hidden * 2.5 + 0.25);
}

// =============================================================================
// UI State
// =============================================================================
let selectedModel = 'rf';

function selectModel(m) {
  selectedModel = m;
  ['lr','rf','nn','all'].forEach(x => {
    const btn = document.getElementById('btn-' + x);
    btn.className = 'model-btn' + (x === m ? ' active-' + x : '');
  });
  const descs = {
    lr: "Logistic Regression — best AUC-ROC (0.941) and recall (90.9%). Highest sensitivity to bankruptcy.",
    rf: "Random Forest — best overall F1 and accuracy. Ensemble of 500 decision trees.",
    nn: "Neural Network — captures non-linear patterns. Balanced accuracy/recall tradeoff.",
    all: "All Three models — compare predictions side by side for maximum insight."
  };
  document.getElementById('model-desc').textContent = descs[m];
}

function getValues() {
  const vals = {};
  for (const f of FEATURES) {
    const el = document.getElementById('inp-' + f.id);
    if (el) vals[f.id] = parseFloat(el.value) || 0;
  }
  return vals;
}

function loadPreset(type) {
  const preset = type === 'safe' ? PRESET_SAFE : PRESET_RISK;
  for (const [k, v] of Object.entries(preset)) {
    const el = document.getElementById('inp-' + k);
    if (el) el.value = v;
  }
}

function clearInputs() {
  for (const f of FEATURES) {
    const el = document.getElementById('inp-' + f.id);
    if (el) el.value = '';
  }
  document.getElementById('results-content').innerHTML = `
    <div class="idle-state">
      <div class="idle-icon">◎</div>
      <div class="idle-text">Enter financial data and click<br>Run Prediction to see results</div>
    </div>`;
}

function runPrediction() {
  const vals = getValues();
  const hasValues = Object.values(vals).some(v => v !== 0);
  if (!hasValues) { alert('Please enter financial values or load a preset first.'); return; }

  const rc = document.getElementById('results-card');
  rc.classList.add('calculating');

  setTimeout(() => {
    rc.classList.remove('calculating');
    const pLR = predictLR(vals);
    const pRF = predictRF(vals);
    const pNN = predictNN(vals);

    const probMap = { lr: pLR, rf: pRF, nn: pNN };
    const mods = selectedModel === 'all' ? ['lr','rf','nn'] : [selectedModel];
    const avgProb = mods.reduce((s,m) => s + probMap[m], 0) / mods.length;

    renderResults(avgProb, probMap, mods, vals);
  }, 400);
}

function renderResults(avgProb, probMap, mods, vals) {
  const pct = Math.round(avgProb * 100);
  const verdictClass = pct < 25 ? 'verdict-safe' : pct < 50 ? 'verdict-warn' : 'verdict-risk';
  const verdictText = pct < 25 ? 'LOW RISK' : pct < 50 ? 'MODERATE RISK' : pct < 70 ? 'HIGH RISK' : 'CRITICAL RISK';
  const gaugeColor = pct < 25 ? '#10b981' : pct < 50 ? '#f59e0b' : '#ef4444';

  // SVG gauge arc
  const r = 70, cx = 100, cy = 90;
  const startAngle = Math.PI; const endAngle = 2 * Math.PI;
  const angle = Math.PI + (avgProb * Math.PI);
  const x1 = cx + r * Math.cos(startAngle), y1 = cy + r * Math.sin(startAngle);
  const x2 = cx + r * Math.cos(endAngle), y2 = cy + r * Math.sin(endAngle);
  const xN = cx + r * Math.cos(angle), yN = cy + r * Math.sin(angle);

  // Risk factor contributions
  const riskContribs = FEATURES.slice(0, 10).map(f => {
    const v = vals[f.id] - f.mean;
    const impact = v * (f.lrCoef || 0) * -1;
    return { name: f.name.substring(0, 28), impact };
  }).sort((a,b) => Math.abs(b.impact) - Math.abs(a.impact)).slice(0, 5);

  let modelRows = '';
  mods.forEach(m => {
    const p = probMap[m];
    const s = MODEL_STATS[m];
    modelRows += `
    <div class="model-result-row">
      <div class="model-result-name" style="color:${s.color}">${s.name}</div>
      <div class="model-result-bar-track">
        <div class="model-result-bar-fill" style="width:${p*100}%;background:${s.color}"></div>
      </div>
      <div class="model-result-prob" style="color:${s.color}">${Math.round(p*100)}%</div>
    </div>`;
  });

  let riskRows = '';
  riskContribs.forEach(r => {
    const cls = r.impact > 0 ? 'up' : 'down';
    const arrow = r.impact > 0 ? '↑' : '↓';
    riskRows += `<div class="risk-factor-row">
      <div class="rf-name">${r.name}</div>
      <div class="rf-impact ${cls}">${arrow} ${Math.abs(r.impact * 10).toFixed(2)}</div>
    </div>`;
  });

  document.getElementById('results-content').innerHTML = `
  <div class="fade-in">
    <div class="gauge-wrap">
      <svg class="gauge-svg" viewBox="0 0 200 100">
        <path d="M${x1},${y1} A${r},${r} 0 0,1 ${x2},${y2}" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="14" stroke-linecap="round"/>
        <path d="M${x1},${y1} A${r},${r} 0 ${angle>Math.PI+Math.PI/2?1:0},1 ${xN},${yN}" fill="none" stroke="${gaugeColor}" stroke-width="14" stroke-linecap="round"/>
        <circle cx="${xN}" cy="${yN}" r="6" fill="${gaugeColor}"/>
      </svg>
      <div class="gauge-label" style="color:${gaugeColor}">${pct}%</div>
      <div class="gauge-sublabel">Bankruptcy Probability</div>
      <div class="gauge-verdict ${verdictClass}">${verdictText}</div>
    </div>

    ${mods.length > 1 ? `
    <div style="margin-top:16px;margin-bottom:8px;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);">Per-Model Breakdown</div>
    ${modelRows}` : `
    <div style="margin-top:8px;font-size:11px;color:var(--muted);text-align:center;">
      ${MODEL_STATS[mods[0]].name} · AUC ${MODEL_STATS[mods[0]].auc}
    </div>`}

    <div style="margin-top:16px;margin-bottom:8px;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);">Top Risk Drivers</div>
    ${riskRows}
  </div>`;
}

// =============================================================================
// BUILD INPUT FORM
// =============================================================================
function buildInputGrid() {
  const grid = document.getElementById('input-grid');
  let html = '';
  FEATURES.forEach(f => {
    html += `
    <div class="input-group">
      <label class="input-label" for="inp-${f.id}">
        ${f.name.length > 26 ? f.name.substring(0,26)+'…' : f.name}
        <span title="${f.hint}">ⓘ</span>
      </label>
      <input class="input-field" id="inp-${f.id}" type="number" step="0.01" min="0" max="${f.id.endsWith('flag')?1:10}" placeholder="${f.mean.toFixed(2)}">
      <div class="input-hint">${f.hint}</div>
    </div>`;
  });
  grid.innerHTML = html;
}

// =============================================================================
// BUILD FEATURE SECTION
// =============================================================================
function buildFeatureBars() {
  const maxGini = FEATURES[0].rfGini;
  let html = '';
  FEATURES.slice(0,20).forEach((f, i) => {
    const pct = (f.rfGini / maxGini * 100).toFixed(1);
    html += `
    <div class="feat-row">
      <div class="feat-rank">${i+1}</div>
      <div class="feat-name" title="${f.name}">${f.name}</div>
      <div class="feat-bar-track"><div class="feat-bar-fill" style="width:${pct}%"></div></div>
      <div class="feat-gini">${f.rfGini.toFixed(0)}</div>
    </div>`;
  });
  document.getElementById('feat-bars').innerHTML = html;
}

function buildFeatureTable() {
  let html = `<thead><tr>
    <th>#</th><th>Feature</th><th>Selection Basis</th>
    <th>RF Gini</th><th>LR Coefficient</th>
  </tr></thead><tbody>`;
  FEATURES.forEach((f, i) => {
    const sel = i >= 20 ? 'Forced (theoretical)' : 'Random Forest Importance';
    const coef = f.lrCoef !== null ? (f.lrCoef > 0 ? `<span style="color:var(--danger)">+${f.lrCoef}</span>` : `<span style="color:var(--safe)">${f.lrCoef}</span>`) : '<span style="color:var(--muted)">N/A</span>';
    html += `<tr>
      <td style="color:var(--muted)">${i+1}</td>
      <td>${f.name}</td>
      <td style="color:var(--muted)">${sel}</td>
      <td style="color:var(--accent2)">${f.rfGini.toFixed(2)}</td>
      <td>${coef}</td>
    </tr>`;
  });
  html += '</tbody>';
  document.getElementById('feature-table').innerHTML = html;
}

// =============================================================================
// TAB NAVIGATION
// =============================================================================
function showSection(name) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('section-' + name).classList.add('active');
  event.target.classList.add('active');
}

// =============================================================================
// INIT
// =============================================================================
document.addEventListener('DOMContentLoaded', () => {
  buildInputGrid();
  buildFeatureBars();
  buildFeatureTable();
  loadPreset('safe');
});
</script>
</body>
</html>
