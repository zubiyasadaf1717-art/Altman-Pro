<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bankruptcy Prediction Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e17;
    --bg2: #0f1520;
    --bg3: #151d2e;
    --card: #111827;
    --border: #1e2d45;
    --accent: #00e5ff;
    --accent2: #7c3aed;
    --accent3: #f59e0b;
    --danger: #ef4444;
    --safe: #10b981;
    --text: #e2e8f0;
    --muted: #64748b;
    --lr: #00e5ff;
    --rf: #7c3aed;
    --nn: #f59e0b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* Animated background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .wrapper { position: relative; z-index: 1; max-width: 1400px; margin: 0 auto; padding: 0 24px 60px; }

  /* Header */
  header {
    padding: 40px 0 32px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 40px;
  }
  .header-inner { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .header-badge {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 4px 10px;
    border-radius: 2px;
    margin-bottom: 10px;
    display: inline-block;
  }
  h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 60%, var(--accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .subtitle { color: var(--muted); font-size: 12px; margin-top: 8px; }
  .header-meta { text-align: right; color: var(--muted); font-size: 11px; }
  .header-meta span { color: var(--accent); }

  /* Nav tabs */
  .nav-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: 36px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px;
    width: fit-content;
  }
  .nav-tab {
    padding: 8px 20px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    transition: all 0.2s;
    border: none;
    background: none;
    font-family: 'DM Mono', monospace;
  }
  .nav-tab:hover { color: var(--text); }
  .nav-tab.active {
    background: var(--bg3);
    color: var(--accent);
    border: 1px solid var(--border);
  }

  /* Sections */
  .section { display: none; }
  .section.active { display: block; }

  /* Grid layouts */
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
  .grid-2-1 { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 28px; }

  @media(max-width: 900px) {
    .grid-4 { grid-template-columns: repeat(2,1fr); }
    .grid-3 { grid-template-columns: 1fr; }
    .grid-2, .grid-2-1 { grid-template-columns: 1fr; }
  }

  /* Cards */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
  }
  .card.lr::before { background: var(--lr); }
  .card.rf::before { background: var(--rf); }
  .card.nn::before { background: var(--nn); }
  .card.accent::before { background: linear-gradient(90deg, var(--accent), var(--accent2)); }

  .card-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .card-value {
    font-family: 'Syne', sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
  }
  .card-sub { font-size: 11px; color: var(--muted); margin-top: 6px; }
  .card-title {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--text);
  }

  /* Stat cards */
  .stat-card { text-align: center; }
  .stat-card .card-value { font-size: 28px; }

  /* Model color labels */
  .lr-text { color: var(--lr); }
  .rf-text { color: var(--rf); }
  .nn-text { color: var(--nn); }

  /* Table */
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th {
    text-align: left;
    padding: 8px 12px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  td { padding: 9px 12px; border-bottom: 1px solid rgba(30,45,69,0.5); }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }

  /* Bar charts */
  .bar-container { display: flex; align-items: center; gap: 8px; }
  .bar-track { flex: 1; height: 6px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 3px; transition: width 0.8s cubic-bezier(0.4,0,0.2,1); }
  .bar-label { font-size: 11px; color: var(--text); min-width: 40px; text-align: right; }

  /* Metric bars */
  .metric-row { margin-bottom: 14px; }
  .metric-header { display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 5px; }
  .metric-name { color: var(--muted); }
  .metric-track { height: 8px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
  .metric-bar { height: 100%; border-radius: 4px; }

  /* Confusion matrix */
  .conf-grid {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 3px;
    font-size: 11px;
    max-width: 260px;
  }
  .conf-cell {
    padding: 10px 8px;
    text-align: center;
    border-radius: 4px;
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
  }
  .conf-header { background: transparent; padding: 6px 8px; color: var(--muted); font-size: 10px; letter-spacing: 0.1em; }
  .conf-label { background: transparent; padding: 10px 4px; color: var(--muted); font-size: 10px; writing-mode: vertical-lr; text-align: center; }
  .conf-tn { background: rgba(16,185,129,0.15); color: var(--safe); }
  .conf-fp { background: rgba(239,68,68,0.1); color: var(--danger); }
  .conf-fn { background: rgba(239,68,68,0.1); color: var(--danger); }
  .conf-tp { background: rgba(16,185,129,0.15); color: var(--safe); }

  /* ROC/image plots */
  .plot-img { width: 100%; border-radius: 6px; display: block; background: var(--bg3); }

  /* Feature importance */
  .feat-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .feat-rank { font-size: 10px; color: var(--muted); width: 20px; flex-shrink: 0; }
  .feat-name { font-size: 11px; color: var(--text); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .feat-bar-track { width: 120px; height: 5px; background: var(--bg3); border-radius: 3px; overflow: hidden; flex-shrink: 0; }
  .feat-bar-fill { height: 100%; border-radius: 3px; background: var(--accent2); }
  .feat-gini { font-size: 10px; color: var(--muted); width: 36px; text-align: right; }

  /* ==========================================================
     LIVE PREDICTION SECTION
  ========================================================== */
  .predict-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 24px;
    align-items: start;
  }
  @media(max-width: 900px) { .predict-layout { grid-template-columns: 1fr; } }

  .input-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-bottom: 20px;
  }
  @media(max-width: 600px) { .input-grid { grid-template-columns: 1fr; } }

  .input-group { display: flex; flex-direction: column; gap: 5px; }
  .input-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .input-label span { color: var(--accent); font-size: 9px; margin-left: 4px; }
  .input-field {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 8px 12px;
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    transition: border-color 0.2s;
    width: 100%;
    -moz-appearance: textfield;
  }
  .input-field::-webkit-outer-spin-button,
  .input-field::-webkit-inner-spin-button { -webkit-appearance: none; }
  .input-field:focus { outline: none; border-color: var(--accent); }
  .input-field::placeholder { color: var(--muted); }

  .input-hint { font-size: 10px; color: var(--muted); margin-top: 2px; }

  /* Model selector */
  .model-selector { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
  .model-btn {
    padding: 6px 16px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg3);
    color: var(--muted);
    cursor: pointer;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s;
  }
  .model-btn:hover { color: var(--text); border-color: var(--muted); }
  .model-btn.active-lr { background: rgba(0,229,255,0.1); color: var(--lr); border-color: var(--lr); }
  .model-btn.active-rf { background: rgba(124,58,237,0.1); color: var(--rf); border-color: var(--rf); }
  .model-btn.active-nn { background: rgba(245,158,11,0.1); color: var(--nn); border-color: var(--nn); }
  .model-btn.active-all { background: rgba(255,255,255,0.06); color: var(--text); border-color: var(--border); }

  /* Predict button */
  .predict-btn {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border: none;
    border-radius: 6px;
    color: #000;
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
    text-transform: uppercase;
  }
  .predict-btn:hover { opacity: 0.9; }
  .predict-btn:active { transform: scale(0.99); }

  /* Load preset buttons */
  .preset-btns { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .preset-btn {
    padding: 5px 12px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 3px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }
  .preset-btn:hover { color: var(--text); border-color: var(--text); }
  .preset-btn.safe { color: var(--safe); border-color: var(--safe); }
  .preset-btn.risk { color: var(--danger); border-color: var(--danger); }

  /* Results panel */
  .results-panel .card { margin-bottom: 0; }

  /* Gauge */
  .gauge-wrap { display: flex; flex-direction: column; align-items: center; padding: 10px 0 16px; }
  .gauge-svg { width: 200px; }
  .gauge-label {
    font-family: 'Syne', sans-serif;
    font-size: 36px;
    font-weight: 800;
    margin-top: -10px;
  }
  .gauge-sublabel { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .gauge-verdict {
    margin-top: 12px;
    padding: 8px 24px;
    border-radius: 4px;
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .verdict-safe { background: rgba(16,185,129,0.15); color: var(--safe); border: 1px solid var(--safe); }
  .verdict-risk { background: rgba(239,68,68,0.15); color: var(--danger); border: 1px solid var(--danger); }
  .verdict-warn { background: rgba(245,158,11,0.15); color: var(--accent3); border: 1px solid var(--accent3); }

  /* Per-model results */
  .model-result-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .model-result-row:last-child { border-bottom: none; }
  .model-result-name { font-size: 12px; }
  .model-result-prob {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
  }
  .model-result-bar-track { flex: 1; height: 4px; background: var(--bg3); border-radius: 2px; margin: 0 12px; overflow: hidden; }
  .model-result-bar-fill { height: 100%; border-radius: 2px; transition: width 0.6s ease; }

  /* Risk factors */
  .risk-factor-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 0;
    border-bottom: 1px solid rgba(30,45,69,0.5);
    font-size: 11px;
  }
  .risk-factor-row:last-child { border-bottom: none; }
  .rf-name { color: var(--muted); flex: 1; }
  .rf-impact { font-weight: 500; }
  .rf-impact.up { color: var(--danger); }
  .rf-impact.down { color: var(--safe); }

  /* Idle state */
  .idle-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
    color: var(--muted);
  }
  .idle-icon { font-size: 48px; margin-bottom: 12px; opacity: 0.4; }
  .idle-text { font-size: 12px; }

  /* Anim */
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .fade-in { animation: fadeIn 0.35s ease forwards; }

  @keyframes pulse-border {
    0%, 100% { border-color: var(--border); }
    50% { border-color: var(--accent); }
  }
  .calculating { animation: pulse-border 0.8s ease infinite; }

  /* Section heading */
  .section-heading {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* Scrollable table wrapper */
  .table-scroll { overflow-x: auto; }

  /* Tooltip */
  .tooltip-wrap { position: relative; display: inline-block; }
  .tooltip-wrap .tip {
    visibility: hidden;
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 11px;
    padding: 6px 10px;
    border-radius: 4px;
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    z-index: 99;
    pointer-events: none;
  }
  .tooltip-wrap:hover .tip { visibility: visible; }

  .tag {
    display: inline-block;
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-left: 6px;
  }
  .tag-best { background: rgba(16,185,129,0.15); color: var(--safe); border: 1px solid var(--safe); }
  .tag-auc { background: rgba(0,229,255,0.1); color: var(--accent); border: 1px solid var(--accent); }

  /* Footer */
  footer {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--muted);
    font-size: 11px;
  }
  footer span { color: var(--accent); }
</style>
</head>
<body>
<div class="wrapper">

  <!-- HEADER -->
  <header>
    <div class="header-inner">
      <div>
        <div class="header-badge">Big Data Module · Group 2</div>
        <h1>Bankruptcy<br>Prediction</h1>
        <p class="subtitle">Three-model ensemble · Taiwanese financial dataset · Binary classification</p>
      </div>
      <div class="header-meta">
        <div>Dataset <span>6,819</span> companies</div>
        <div>Features <span>22</span> selected</div>
        <div>Train/Test <span>80/20</span> split</div>
        <div>SMOTE <span>balanced</span></div>
      </div>
    </div>
  </header>

  <!-- NAV TABS -->
  <div class="nav-tabs">
    <button class="nav-tab active" onclick="showSection('overview')">Overview</button>
    <button class="nav-tab" onclick="showSection('models')">Models</button>
    <button class="nav-tab" onclick="showSection('features')">Features</button>
    <button class="nav-tab" onclick="showSection('predict')">Live Prediction</button>
  </div>

  <!-- ============================================================
       SECTION 1: OVERVIEW
  ============================================================ -->
  <div id="section-overview" class="section active">

    <div class="grid-4">
      <div class="card stat-card lr">
        <div class="card-label">Logistic Regression</div>
        <div class="card-value lr-text">88.1%</div>
        <div class="card-sub">Accuracy · AUC <strong>0.941</strong></div>
      </div>
      <div class="card stat-card rf">
        <div class="card-label">Random Forest</div>
        <div class="card-value rf-text">93.7%</div>
        <div class="card-sub">Accuracy · AUC <strong>0.924</strong></div>
      </div>
      <div class="card stat-card nn">
        <div class="card-label">Neural Network</div>
        <div class="card-value nn-text">92.7%</div>
        <div class="card-sub">Accuracy · AUC <strong>0.853</strong></div>
      </div>
      <div class="card stat-card accent">
        <div class="card-label">Best F1-Score</div>
        <div class="card-value rf-text">41.9%</div>
        <div class="card-sub">Random Forest · minority class</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card accent">
        <div class="card-title">Model Performance Comparison</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Model</th>
                <th>Accuracy</th>
                <th>Precision</th>
                <th>Recall</th>
                <th>F1</th>
                <th>AUC-ROC</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><span class="lr-text">●</span> Logistic Regression</td>
                <td>88.1%</td>
                <td>20.2%</td>
                <td>90.9% <span class="tag tag-best">Best</span></td>
                <td>33.1%</td>
                <td>0.941 <span class="tag tag-auc">Best AUC</span></td>
              </tr>
              <tr>
                <td><span class="rf-text">●</span> Random Forest</td>
                <td>93.7% <span class="tag tag-best">Best</span></td>
                <td>29.8%<span class="tag tag-best"> Best</span></td>
                <td>70.5%</td>
                <td>41.9% <span class="tag tag-best">Best</span></td>
                <td>0.924</td>
              </tr>
              <tr>
                <td><span class="nn-text">●</span> Neural Network</td>
                <td>92.7%</td>
                <td>26.1%</td>
                <td>68.2%</td>
                <td>37.7%</td>
                <td>0.853</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Key Metrics at a Glance</div>
        <div class="metric-row">
          <div class="metric-header"><span class="metric-name">LR Accuracy</span><span class="lr-text">88.1%</span></div>
          <div class="metric-track"><div class="metric-bar" style="width:88.1%;background:var(--lr)"></div></div>
        </div>
        <div class="metric-row">
          <div class="metric-header"><span class="metric-name">RF Accuracy</span><span class="rf-text">93.7%</span></div>
          <div class="metric-track"><div class="metric-bar" style="width:93.7%;background:var(--rf)"></div></div>
        </div>
        <div class="metric-row">
          <div class="metric-header"><span class="metric-name">NN Accuracy</span><span class="nn-text">92.7%</span></div>
          <div class="metric-track"><div class="metric-bar" style="width:92.7%;background:var(--nn)"></div></div>
        </div>
        <div class="metric-row">
          <div class="metric-header"><span class="metric-name">LR AUC-ROC</span><span class="lr-text">94.1%</span></div>
          <div class="metric-track"><div class="metric-bar" style="width:94.1%;background:var(--lr)"></div></div>
        </div>
        <div class="metric-row">
          <div class="metric-header"><span class="metric-name">RF AUC-ROC</span><span class="rf-text">92.4%</span></div>
          <div class="metric-track"><div class="metric-bar" style="width:92.4%;background:var(--rf)"></div></div>
        </div>
        <div class="metric-row">
          <div class="metric-header"><span class="metric-name">NN AUC-ROC</span><span class="nn-text">85.3%</span></div>
          <div class="metric-track"><div class="metric-bar" style="width:85.3%;background:var(--nn)"></div></div>
