  { id:"cash_turnover",     name:"Cash Turnover Rate",                      lrCoef:-0.437,  rfGini:157.89, mean:0.50, hint:"Cash utilisation efficiency" },
  { id:"eq_liab",           name:"Equity to Liability",                     lrCoef:0.150,   rfGini:150.97, mean:0.50, hint:"Shareholder equity coverage of debt" },
  { id:"roa_a",             name:"ROA A (before interest, after tax)",      lrCoef:2.341,   rfGini:148.14, mean:0.56, hint:"Post-tax operating asset return" },
  { id:"int_exp_ratio",     name:"Interest Expense Ratio",                  lrCoef:0.033,   rfGini:146.97, mean:0.50, hint:"Interest costs relative to revenue" },
  { id:"roa_b",             name:"ROA B (before interest & depreciation)",  lrCoef:-0.307,  rfGini:140.41, mean:0.55, hint:"EBITDA-based return on assets" },
  { id:"liab_assets_flag",  name:"Liability Assets Flag",                   lrCoef:-2.266,  rfGini:1.01,   mean:0.50, hint:"Binary: liabilities > assets flag" },
